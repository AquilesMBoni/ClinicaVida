# Copie para .env e ajuste se quiser (todas as variáveis são opcionais)

# Banco SQLite (padrão: backend/clinicavida.db)
# DATABASE_URL=sqlite:///./clinicavida.db

# Origens liberadas no CORS (Live Server usa a porta 5500)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Token da rota GET /api/appointments (lista da recepção) — envie no cabeçalho X-Admin-Token
ADMIN_TOKEN=troque-este-token

# LLM opcional, usado só quando as regras/FAQ não acham resposta.
# Exemplo com Ollama rodando localmente:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=
# LLM_TIMEOUT=20

RATE_LIMIT_PER_MINUTE=30
